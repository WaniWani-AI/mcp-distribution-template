WANIWANI_API_KEY=<your-api-key>
WANIWANI_PUBLIC_KEY=<your-public-key>

# Only with the self-hosted agent runtime (docs/self-hosted-agent.md). Setting
# the runtime's URL mounts /agent/v1, and then the two keys above and the
# allowlist below are all required.
# WANIWANI_AGENT_EVE_URL=http://eve:3001
# WANIWANI_ALLOWED_ORIGINS=https://example.com,https://www.example.com
