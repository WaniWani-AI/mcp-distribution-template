WANIWANI_API_KEY=<your-api-key>
WANIWANI_PUBLIC_KEY=<your-public-key>

# Only with the self-hosted agent runtime (docs/self-hosted-agent.md). Setting
# the runtime's origin mounts /agent/v1, and then the two keys above and the
# allowlist below are all required. Scheme, host and port only: this server
# appends /eve/v1 itself. `http://eve:3001` inside the reference compose file,
# `http://127.0.0.1:3001` when this server runs on the host beside it.
# WANIWANI_AGENT_EVE_URL=http://eve:3001
# WANIWANI_ALLOWED_ORIGINS=https://example.com,https://www.example.com
